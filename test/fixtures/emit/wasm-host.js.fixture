// Generated by opuromc for app Counter; loads the wasm module and forwards events.
"use strict";
const canvas = document.getElementById("app");
const ctx = canvas.getContext("2d");
let wasm = null;
const mirror = {};
mirror["count"] = 0;
const STATE_NAMES = ["count"];
const MIRROR_ACTIONS = {
};
const TREE = { id: 0, kind: "Column", x: 0, y: 0, w: 0, h: 0, padding: 16, gap: 8, children: [
  { id: 1, kind: "Text", x: 0, y: 0, w: 0, h: 0, value: "Count: {count}", size: 24 },
  { id: 2, kind: "Row", x: 0, y: 0, w: 0, h: 0, gap: 8, children: [
    { id: 3, kind: "Button", x: 0, y: 0, w: 0, h: 0, label: "-", tap: true },
    { id: 4, kind: "Button", x: 0, y: 0, w: 0, h: 0, label: "+", tap: true }
  ] }
] };
function textOf(value) {
  return String(value).replace(/\{([A-Za-z_][A-Za-z0-9_]*)\}/g, function (_, name) {
    if (name in mirror) { return String(mirror[name]); }
    return "";
  });
}

function intrinsic(node) {
  if (node.kind === "Text") {
    const size = node.size || 16;
    return [String(node.value || "").length * size * 0.6 + 4, size * 1.5];
  }
  if (node.kind === "Button") {
    return [String(node.label || "").length * 10 + 28, 32];
  }
  if (node.kind === "Input") { return [200, 32]; }
  if (node.kind === "Image") { return [node.width || 100, node.height || 100]; }
  return [0, 0];
}

function layout(node, x, y) {
  const pad = node.padding || 0;
  const gap = node.gap === undefined ? 4 : node.gap;
  const kids = node.children || [];
  const vertical = node.kind === "Column" || node.kind === "List" || node.kind === "Card";
  const horizontal = node.kind === "Row" || node.kind === "Container";
  if (kids.length > 0 && (vertical || horizontal)) {
    let cx = x + pad, cy = y + pad, maxW = 0, maxH = 0;
    for (const child of kids) {
      const box = layout(child, cx, cy);
      maxW = Math.max(maxW, box.w);
      maxH = Math.max(maxH, box.h);
      if (vertical) { cy += box.h + gap; } else { cx += box.w + gap; }
    }
    const w = vertical ? maxW + 2 * pad : cx - x - gap + pad;
    const h = vertical ? cy - y - gap + pad : maxH + 2 * pad;
    node.x = x; node.y = y; node.w = Math.max(w, 1); node.h = Math.max(h, 1);
    return { w: node.w, h: node.h };
  }
  const size = intrinsic(node);
  node.x = x; node.y = y; node.w = Math.max(size[0], 1); node.h = Math.max(size[1], 1);
  return { w: node.w, h: node.h };
}

function render() {
  layout(TREE, 16, 16);
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.textBaseline = "top";
  drawNode(TREE);
}

function drawNode(node) {
  if (node.when && !mirror[node.when]) { return; }
  if (node.unless && mirror[node.unless]) { return; }
  const x = node.x, y = node.y, w = node.w, h = node.h;
  if (node.kind === "Text") {
    ctx.font = (node.size || 16) + "px sans-serif";
    ctx.fillStyle = node.color || "#111111";
    ctx.fillText(textOf(node.value || ""), x, y);
  } else if (node.kind === "Button") {
    ctx.fillStyle = "#097FEB";
    ctx.fillRect(x, y, w, h);
    ctx.fillStyle = "#ffffff";
    ctx.font = "16px sans-serif";
    ctx.fillText(node.label || "", x + 10, y + 8);
  } else if (node.kind === "Container" || node.kind === "Card") {
    ctx.fillStyle = node.color || "#f1f5f9";
    ctx.fillRect(x, y, w, h);
  }
  for (const child of node.children || []) { drawNode(child); }
}

function syncStates() {
  for (let i = 0; i < wasm.opu_state_len(); i++) {
    const name = STATE_NAMES[i];
    if (name) { mirror[name] = wasm.opu_state(i); }
  }
}

function applyMirror(id) {
  for (const action of MIRROR_ACTIONS[id] || []) {
    const target = action.target;
    if (action.op === "toggle") {
      mirror[target] = !mirror[target];
    } else if (action.op === "set") {
      mirror[target] = action.valueFrom !== undefined ? mirror[action.valueFrom] : action.value;
    } else if (action.op === "add") {
      const from = action.valueFrom !== undefined ? mirror[action.valueFrom] : action.value;
      mirror[target] = Number(mirror[target]) + Number(from);
    }
  }
}

function applyTap(id) {
  if (!wasm) { return 0; }
  const patches = wasm.opu_tap(id);
  applyMirror(id);
  syncStates();
  render();
  return patches;
}

function applyInput(id, value) {
  if (!wasm) { return 0; }
  const n = parseInt(value, 10);
  const patches = wasm.opu_input(id, isNaN(n) ? 0 : n);
  applyMirror(id);
  syncStates();
  render();
  return patches;
}

canvas.addEventListener("click", function (event) {
  const rect = canvas.getBoundingClientRect();
  const x = event.clientX - rect.left;
  const y = event.clientY - rect.top;
  if (!wasm) { return; }
  const hit = hitTest(TREE, x, y);
  if (hit !== null) { applyTap(hit); }
});

function hitTest(node, x, y) {
  for (const child of node.children || []) {
    const found = hitTest(child, x, y);
    if (found !== null) { return found; }
  }
  if (node.tap && x >= node.x && x <= node.x + node.w && y >= node.y && y <= node.y + node.h) {
    return node.id;
  }
  return null;
}

async function boot() {
  const bytes = await fetch("opurom_wasm.wasm").then(function (r) { return r.arrayBuffer(); });
  const module = await WebAssembly.instantiate(bytes, {});
  wasm = module.instance.exports;
  render();
}

boot();
