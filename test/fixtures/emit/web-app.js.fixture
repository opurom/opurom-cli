// Generated by opuromc for app Counter; straight-line code, no IR interpreter.
"use strict";
const canvas = document.getElementById("app");
const ctx = canvas.getContext("2d");
const state = {"count":0};

function render() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.textBaseline = "top";
  ctx.fillStyle = "#334155";
  ctx.font = "14px sans-serif";
  ctx.fillText("", 16 + 6, 16 + 6);
  ctx.font = "24px sans-serif";
  ctx.fillStyle = "#111111";
  ctx.fillText("Count: " + String(state.count), 32, 32);
  ctx.fillStyle = "#334155";
  ctx.font = "14px sans-serif";
  ctx.fillText("", 32 + 6, 76 + 6);
  ctx.fillStyle = "#097FEB";
  ctx.fillRect(32, 76, 38, 32);
  ctx.fillStyle = "#ffffff";
  ctx.font = "16px sans-serif";
  ctx.fillText("-", 32 + 10, 76 + 8);
  ctx.fillStyle = "#097FEB";
  ctx.fillRect(78, 76, 38, 32);
  ctx.fillStyle = "#ffffff";
  ctx.font = "16px sans-serif";
  ctx.fillText("+", 78 + 10, 76 + 8);
}

async function applyTap(id) {
  if (id === 3) { state.count += -1;
  render(); return; }
  if (id === 4) { state.count += 1;
  render(); return; }
}

function applyInput(id, text) {
}

canvas.addEventListener("click", function (e) {
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  if (x >= 32 && x <= 70 && y >= 76 && y <= 108) { applyTap(3); }
  if (x >= 78 && x <= 116 && y >= 76 && y <= 108) { applyTap(4); }
});

render();
